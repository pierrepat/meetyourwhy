# ============================================
# MeetYourWhy — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your real keys.
# NEVER commit .env.local with real values.
# ============================================

# --- Anthropic (Interview + Report AI) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (Whisper voice transcription) ---
OPENAI_API_KEY=sk-...

# --- Supabase (Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (Email delivery) ---
RESEND_API_KEY=re_...

# --- PostHog (Analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Meta Pixel (Instagram ads tracking) ---
# Only fires: landing_view, discovery_start, interview_complete
# NEVER sends transcript text, results, or interpretations
NEXT_PUBLIC_META_PIXEL_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
